      "source": [
        "import astropy.constants as const\n",
        "import astropy.units as u\n",
        "import numpy as np\n",
        "\n",
        "mu = 2.4\n",
        "temp = 10. * u.K\n",
        "rho = 1e5 * u.M_sun / u.pc**3.\n",
        "\n",
        "\n",
        "((5. * const.k_B / (const.G * mu * const.m_p))**1.5 * (3. / (4. * np.pi))**.5 * temp**1.5 * rho**-.5).to(\"M_sun\")"
      ]
    },
